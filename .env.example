# Database (Railway Postgres — set automatically when you add the plugin)
DATABASE_URL="postgresql://user:password@localhost:5432/marnehaus"

# Clerk Auth (landlord)
CLERK_SECRET_KEY="sk_live_..."
CLERK_PUBLISHABLE_KEY="pk_live_..."

# Stripe (live keys — set as Railway env vars only, never commit)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (email)
RESEND_API_KEY="re_..."
EMAIL_FROM="MarneHaus <noreply@marnehaus.com>"

# App URL (set to your Railway public URL after first deploy)
APP_URL="https://marnehaus.up.railway.app"
PORT=3001
NODE_ENV=production
CORS_ORIGIN="https://marnehaus.up.railway.app"

# Storage — Cloudflare R2 or AWS S3 (leave unset to use local filesystem in dev)
# STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# AWS_S3_BUCKET="marnehaus-uploads"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="auto"

# Frontend (Vite build-time — set in Railway as a build env var)
VITE_CLERK_PUBLISHABLE_KEY="pk_live_..."
VITE_API_URL="/api"
